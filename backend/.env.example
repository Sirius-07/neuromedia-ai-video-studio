# Server
NODE_ENV=production
PORT=4300
PUBLIC_URL=https://api.example.com
FRONTEND_URL=https://app.example.com
CORS_ORIGIN=https://app.example.com
UPLOADS_DIR=/opt/neuromedia/backend/uploads

# Database
# Demo SQLite on a persistent disk:
DATABASE_URL=file:/var/www/neuromedia/data/production.db
# Production Postgres example:
# DATABASE_URL=postgresql://user:password@host:5432/neuromedia?schema=public

# Feature flags
# ComfyUI and TTS are off by default for cloud deployment.
ENABLE_COMFYUI=false
ENABLE_TTS=false

# Optional ComfyUI settings, only used when ENABLE_COMFYUI=true
# COMFYUI_API_URL=http://127.0.0.1:8188
# COMFYUI_INPUT_DIR=/opt/ComfyUI/input
# COMFYUI_OUTPUT_DIR=/opt/ComfyUI/output

# Optional IndexTTS2 settings, only used when ENABLE_TTS=true
# INDEXTTS2_HOST=127.0.0.1
# INDEXTTS2_PORT=6006
# PYTHON_PATH=python3

# Volcengine / ARK
VOLCENGINE_ACCESS_KEY=your_access_key_here
VOLCENGINE_SECRET_KEY=your_secret_key_here
ARK_API_KEY=your_ark_api_key_here

# Volcengine TOS object storage
TOS_ACCESS_KEY_ID=your_tos_access_key_id
TOS_SECRET_ACCESS_KEY=your_tos_secret_access_key
TOS_REGION=cn-guangzhou
TOS_BUCKET=your_bucket_name
